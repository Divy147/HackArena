# Firebase Client Configuration (Optional for Live Firebase Integration)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=hackarena-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hackarena-app
VITE_FIREBASE_STORAGE_BUCKET=hackarena-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Gemini API Key (Can also be set in server/.env)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
