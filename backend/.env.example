# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=hackarena_super_secret_jwt_key_2026_production_secure_phrase
JWT_EXPIRES_IN=7d

# Google Gemini API
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Firebase Admin SDK Configuration
# Optional for local test mode (fallback in-memory database will be used if omitted)
FIREBASE_PROJECT_ID=hackarena-cyber
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hackarena-cyber.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://hackarena-cyber-default-rtdb.firebaseio.com

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
